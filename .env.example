# ── App Store Ranking MCP Server – Environment Variables ──────────────────
#
# Copy this file to .env and fill in your values.

# ── Response format (optional) ───────────────────────────────────────────
# Format for API responses. Options: "json" or "toon"
# "json" - Standard JSON format (default)
# "toon" - Token-Oriented Object Notation (30-60% token reduction)
#         See: https://pypi.org/project/python-toon/
RESPONSE_FORMAT="json"
